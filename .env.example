# Copie para .env para sobrescrever localmente os valores de config/<TEST_ENV>.env
# Ambiente: dev | staging | production (padrão: dev)
TEST_ENV=dev

# Obrigatórias
BASE_URL=https://www.saucedemo.com
TEST_USERNAME=standard_user
TEST_PASSWORD=secret_sauce
DEFAULT_TIMEOUT=30000
CHECKOUT_FIRST_NAME=Ana
CHECKOUT_LAST_NAME=Silva
CHECKOUT_POSTAL_CODE=01001-000

# Opcionais
# HEADLESS=false
# SLOWMO=0
# DEBUG_BDD=false
# A11Y_FAIL_IMPACTS=critical,serious
# RETRY=0
# TRACE=on-failure   # off | on-failure | on
# VIDEO=off          # off | on-failure | on
